// Optional local overrides. Copy to Local.xcconfig (git-ignored).
// Model credentials belong on the backend; the app always uses Edge Functions.

// Optional. Point a DEBUG build at a locally served copy of the Edge Functions.
// ⚠️ The $() is not a typo: xcconfig treats // as a comment, so the slashes have to be
// split or the value is truncated to "http:".
// NB_FUNCTIONS_BASE = http:/$()/127.0.0.1:8000/functions/v1

// Public RevenueCat SDK key (appl_…). The secret API key stays on the server.
// REVENUECAT_API_KEY = appl_your_public_sdk_key
// Debug defaults to the NEXT RevenueCat Test Store key in BillingCatalog.
// Release accepts only appl_ keys; never ship a test_ key to the App Store.
// Set the DEBUG launch environment NB_DEBUG_RC_STORE=app_store to use Apple's sandbox.
