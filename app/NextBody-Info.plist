<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>NextBody</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 01 · Google 原生登录。这个 client ID 不是机密（它和 bundle id 绑定，Google 靠 bundle
	     校验来源），反转形式就是 SDK 回调用的 URL scheme。Supabase 那边校验的正是它做 aud。 -->
	<key>GIDClientID</key>
	<string>285632967349-gnn01criesqi6itpf8kr4lfherfhu36i.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.285632967349-gnn01criesqi6itpf8kr4lfherfhu36i</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nextbody.hoop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nextbody</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NBFunctionsBase</key>
	<string>$(NB_FUNCTIONS_BASE)</string>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<!-- Only 127.0.0.1, and only so a DEBUG build can talk to a locally served copy of the
	     Edge Functions. Nothing else is exempted, and the loopback exception cannot reach
	     anything off this machine. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NextBody connects to your band to read heart rate, steps and sleep.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>NextBody connects to your band to read heart rate, steps and sleep.</string>
	<key>NSCameraUsageDescription</key>
	<string>Photograph your meal so NextBody can log the food.</string>
	<!-- F5 §03 · the string is the board's own; its two "never"s are promises. Four read types, nothing written back. -->
	<key>NSHealthShareUsageDescription</key>
	<string>HOOP reads your sex, date of birth, height and weight from Health to set up your baseline. It never writes to Health, and never shares this data.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>NextBody uses Health only to read your body measurements for your baseline. It does not write to Health.</string>
	<!-- Required by linked band SDK APIs; the app does not request library access. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>NextBody does not access your music library. You can use all workout features without granting music access.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to NextBody instead of typing.</string>
	<key>NSMotionUsageDescription</key>
	<string>Count steps when your band is out of range.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo of your meal so NextBody can log the food.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into a logged meal.</string>
	<!-- 14 · the session on the Dynamic Island and the Lock Screen. The activity carries
	     three numbers and no identity; it ends with the session. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Doto-Black.ttf</string>
		<string>Doto-Bold.ttf</string>
		<string>Doto-ExtraBold.ttf</string>
		<string>Doto-Medium.ttf</string>
		<string>Doto-Regular.ttf</string>
		<string>Doto-SemiBold.ttf</string>
		<string>InterTight-Black.ttf</string>
		<string>InterTight-Bold.ttf</string>
		<string>InterTight-ExtraBold.ttf</string>
		<string>InterTight-Light.ttf</string>
		<string>InterTight-Medium.ttf</string>
		<string>InterTight-Regular.ttf</string>
		<string>InterTight-SemiBold.ttf</string>
		<string>Jost-Bold.ttf</string>
		<string>Jost-ExtraLight.ttf</string>
		<string>Jost-Light.ttf</string>
		<string>Jost-Medium.ttf</string>
		<string>Jost-Regular.ttf</string>
		<string>Jost-SemiBold.ttf</string>
		<string>fusion-pixel-12px-proportional-zh_hans.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nextbody.hoop.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>fetch</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
