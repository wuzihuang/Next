<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>NextBody</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NBDebugModelKey</key>
	<string>$(NB_DEBUG_MODEL_KEY)</string>
	<key>NBFunctionsBase</key>
	<string>$(NB_FUNCTIONS_BASE)</string>
	<!-- Only 127.0.0.1, and only so a DEBUG build can talk to a locally served copy of the
	     Edge Functions. Nothing else is exempted, and the loopback exception cannot reach
	     anything off this machine. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NextBody connects to your band to read heart rate, steps and sleep.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>NextBody connects to your band to read heart rate, steps and sleep.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of your meal so NextBody can log it.</string>
	<!-- F5 §03 · the string is the board's own; its two "never"s are promises. Four read types, nothing written back. -->
	<key>NSHealthShareUsageDescription</key>
	<string>HOOP reads your sex, date of birth, height and weight from Health to set up your baseline. It never writes to Health, and never shares this data.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to NextBody instead of typing.</string>
	<key>NSMotionUsageDescription</key>
	<string>Count steps when your band is out of range.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo of your meal so NextBody can log it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into a logged meal.</string>
	<!-- 14 · the session on the Dynamic Island and the Lock Screen. The activity carries
	     three numbers and no identity; it ends with the session. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Doto-Black.ttf</string>
		<string>Doto-Bold.ttf</string>
		<string>Doto-ExtraBold.ttf</string>
		<string>Doto-Medium.ttf</string>
		<string>Doto-Regular.ttf</string>
		<string>Doto-SemiBold.ttf</string>
		<string>InterTight-Black.ttf</string>
		<string>InterTight-Bold.ttf</string>
		<string>InterTight-ExtraBold.ttf</string>
		<string>InterTight-Light.ttf</string>
		<string>InterTight-Medium.ttf</string>
		<string>InterTight-Regular.ttf</string>
		<string>InterTight-SemiBold.ttf</string>
		<string>Jost-Bold.ttf</string>
		<string>Jost-ExtraLight.ttf</string>
		<string>Jost-Light.ttf</string>
		<string>Jost-Medium.ttf</string>
		<string>Jost-Regular.ttf</string>
		<string>Jost-SemiBold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
