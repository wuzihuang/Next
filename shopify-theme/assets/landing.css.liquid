  overflow: clip;
}

.lp-next-head {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 100px 80px 48px;
  text-align: center;
}

.lp-next-head b {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 28px;
  font-weight: 600;
}

.lp-next-head h2 {
  color: #fff;
  font-family: 'Noto Sans SC', var(--lp-inter), sans-serif;
  font-size: 64px;
  font-weight: 600;
  line-height: 76px;
}

.lp-next-head em {
  color: var(--lp-lime);
  font-family: var(--lp-doto);
  font-size: 18px;
  font-style: normal;
  font-weight: 600;
  letter-spacing: 0.22em;
}

.lp-next-head p {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 21px;
  line-height: 30px;
  max-width: 720px;
}

.lp-chase {
  background: #000 url('{{ 'chase.png' | asset_url }}') 50% / cover;
  height: 760px;
  position: relative;
}

.lp-chase-words {
  bottom: 44px;
  color: #fff;
  display: flex;
  font-family: var(--lp-doto);
  font-size: 16px;
  font-weight: 600;
  justify-content: space-between;
  left: 80px;
  letter-spacing: 0.28em;
  position: absolute;
  right: 80px;
}

.lp-chase-words em {
  color: var(--lp-lime);
  font-style: normal;
}

.lp-finishes {
  align-items: center;
  background: #000;
  display: flex;
  flex-direction: column;
  padding: 100px 0 80px;
}

.lp-finishes-head {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding-bottom: 48px;
  text-align: center;
  width: min(980px, calc(100% - 80px));
}

.lp-finishes-head b {
  color: #ffffff8c;
  font-family: var(--lp-doto);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.34em;
}

.lp-finishes-head strong {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 88px;
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 88px;
}

.lp-finishes-head h2 {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 28px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.lp-finishes-head p {
  color: #ffffff99;
  font-size: 16px;
  line-height: 26px;
  max-width: 640px;
}

.lp-facts {
  display: flex;
  justify-content: space-between;
  padding-bottom: 56px;
  width: min(720px, calc(100% - 80px));
}

.lp-facts div {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 160px;
}

.lp-facts strong {
  color: #fff;
  font-family: var(--lp-doto);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.lp-facts span {
  color: #ffffff8c;
  font-family: var(--lp-doto);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.22em;
}

.lp-finishes-photo {
  background: #000 url('{{ 'finishes.png' | asset_url }}') 50% / cover;
  height: 760px;
  width: 100%;
}

.lp-finish-labels {
  display: flex;
  justify-content: space-between;
  padding-top: 20px;
  width: min(980px, calc(100% - 80px));
}

.lp-finish-labels div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 200px;
}

.lp-finish-labels div:last-child {
  align-items: flex-end;
}

.lp-finish-labels b {
  color: #fff;
  font-family: var(--lp-doto);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.2em;
}

.lp-finish-labels span {
  color: #ffffff8c;
  font-size: 15px;
  line-height: 20px;
}

.lp-signals {
  align-items: center;
  background: #000;
  display: flex;
  flex-direction: column;
  gap: 48px;
  padding: 100px 80px;
}

.lp-signals-head {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: center;
  width: min(980px, 100%);
}

.lp-signals-head b {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 28px;
  font-weight: 600;
}

.lp-signals-head h2 {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 64px;
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 68px;
}

.lp-signals-head p {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 21px;
  line-height: 29px;
  max-width: 780px;
}

.lp-signals-head span {
  color: #86868b;
  font-family: var(--lp-inter);
  font-size: 14px;
  line-height: 20px;
}

.lp-sig-grid {
  display: grid;
  gap: 44px 20px;
  grid-template-columns: repeat(4, 1fr);
  width: min(980px, 100%);
}

.lp-sig {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.lp-sig-icon {
  align-items: center;
  background: #161616;
  border: 1px solid var(--lp-hair);
  border-radius: 999px;
  display: flex;
  height: 96px;
  justify-content: center;
  width: 96px;
}

.lp-sig.is-dash .lp-sig-icon {
  border-style: dashed;
  border-color: #ffffff59;
}

.lp-sig span {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-align: center;
}

.lp-close {
  align-items: center;
  border-bottom: 1px solid var(--lp-hair);
  display: flex;
  flex-direction: column;
  overflow: clip;
  padding: 190px 80px 170px;
  position: relative;
  text-align: center;
}

.lp-close-orbit {
  height: 640px;
  left: 50%;
  pointer-events: none;
  position: absolute;
  top: 40px;
  transform: translateX(-50%);
  width: 1000px;
}

.lp-close b {
  color: var(--lp-lime);
  font-family: var(--lp-doto);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.4em;
  margin-bottom: 48px;
  position: relative;
}

.lp-close h2 {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 96px;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 100px;
  margin-bottom: 32px;
  position: relative;
  white-space: pre-wrap;
}

.lp-close p {
  color: #ffffff99;
  font-size: 17px;
  line-height: 28px;
  margin-bottom: 52px;
  max-width: 440px;
  position: relative;
}

.lp-close .lp-pill-lime {
  position: relative;
}

.lp-foot {
  display: flex;
  justify-content: space-between;
  padding: 64px 48px;
}

.lp-foot-brand {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.lp-foot-brand p {
  color: #ffffff99;
  font-size: 14px;
}

.lp-foot-cols {
  display: flex;
  gap: 64px;
}

.lp-foot-col {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 98px;
}

.lp-foot-col b {
  color: #ffffff66;
  font-family: var(--lp-doto);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  padding-bottom: 6px;
}

.lp-foot-col a {
  color: #ffffffb3;
  font-size: 14px;
  line-height: 18px;
}

.lp-legal {
  border-top: 1px solid var(--lp-hair);
  color: #ffffff66;
  display: flex;
  font-family: var(--lp-doto);
  font-size: 12px;
  justify-content: space-between;
  letter-spacing: 0.04em;
  padding: 20px 48px;
}

.lp-menu-btn {
  background: none;
  border: 0;
  color: #fff;
  display: none;
  font-family: var(--lp-doto);
  font-size: 12px;
  letter-spacing: 0.16em;
}

@media (max-width: 1100px) {
  .lp-sign,
  .lp-menu-btn {
    display: none;
  }

  .lp-nav {
    align-items: center;
    display: grid;
    gap: 10px 16px;
    grid-template-areas:
      'brand end'
      'mid mid';
    grid-template-columns: 1fr auto;
    height: auto;
    min-height: 64px;
    padding: 12px 24px 10px;
  }

  .lp-wordmark {
    grid-area: brand;
    justify-self: start;
    width: max-content;
  }

  .lp-nav-end {
    grid-area: end;
    justify-self: end;
  }

  .lp-nav-mid {
    display: flex;
    gap: 16px;
    grid-area: mid;
    justify-content: space-between;
    left: auto;
    position: static;
    transform: none;
    width: 100%;
  }

  .lp-hero {
    height: auto;
    min-height: 720px;
  }

  .lp-hero-inner {
    padding: 40px 24px 0;
  }

  .lp-hero h1,
  .lp-close h2 {
    font-size: 48px;
    line-height: 1.05;
    white-space: normal;
  }

  .lp-display-title,
  .lp-hl-title,
  .lp-comp-head h2,
  .lp-signals-head h2,
  .lp-next-head h2 {
    font-size: 36px;
    line-height: 40px;
  }

  .lp-gallery-head,
  .lp-radar,
  .lp-stress-live,
  .lp-coach-top,
  .lp-caps,
  .lp-stress-out {
    flex-direction: column;
  }

  .lp-gallery-aside,
  .lp-radar-copy,
  .lp-stress-num {
    width: 100%;
  }

  .lp-hl-card {
    width: calc((100% - 24px) / 2);
  }

  .lp-gallery-row,
  .lp-phones {
    display: flex;
    flex-direction: row;
    -webkit-overflow-scrolling: touch;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .lp-gallery-row::-webkit-scrollbar,
  .lp-phones::-webkit-scrollbar {
    display: none;
  }

  .lp-shot {
    flex: 0 0 72%;
    height: 460px;
    scroll-snap-align: start;
  }

  .lp-phones {
    gap: 18px;
    height: auto;
    justify-content: flex-start;
    padding: 12px 24px 72px;
  }

  .lp-phone-sleep,
  .lp-phone-heart,
  .lp-phone-vitals,
  .lp-phone-battery,
  .lp-phone-l {
    display: block;
    flex: 0 0 auto;
    left: auto;
    position: relative;
    scroll-snap-align: center;
    top: auto;
    transform: none;
  }

  .lp-face {
    flex: 0 0 228px;
  }

  .lp-radar {
    padding: 48px 24px;
  }

  .lp-radar img {
    height: 280px;
    width: 100%;
  }

  .lp-comp-hero {
    align-items: center;
    background-position: 70% 40%;
    display: flex;
    height: auto;
    justify-content: center;
    min-height: 280px;
    padding: 24px 0 8px;
  }

  .lp-comp-phone {
    height: auto;
    left: auto;
    margin: 24px auto 32px;
    position: relative;
    right: auto;
    top: 0;
    transform: none;
    width: min(390px, calc(100% - 32px));
  }

  .lp-comp-grid {
    width: 100%;
  }

  .lp-comp-grid div {
    width: calc((100% - 16px) / 3);
  }

  .lp-comp-hero-nums::before {
    width: calc(100% - 48px);
  }

  .lp-sig-grid {
    gap: 28px 16px;
    grid-template-columns: repeat(2, 1fr);
  }

  .lp-nav,
  .lp-gallery,
  .lp-science,
  .lp-stress,
  .lp-hl-head,
  .lp-hl-grid,
  .lp-app-copy,
  .lp-close,
  .lp-foot,
  .lp-legal,
  .lp-signals,
  .lp-next-head {
    padding-left: 24px;
    padding-right: 24px;
  }

  .lp-hero-floor {
    flex-wrap: wrap;
    gap: 12px;
  }

  .lp-chase-words {
    flex-wrap: wrap;
    font-size: 12px;
    gap: 8px;
    left: 24px;
    letter-spacing: 0.12em;
    right: 24px;
  }

  .lp-finishes-head strong {
    font-size: 64px;
    line-height: 64px;
  }

  .lp-chase,
  .lp-finishes-photo {
    height: 480px;
  }

  .lp-close {
    padding-bottom: 80px;
    padding-top: 80px;
  }

  .lp-close-orbit {
    height: 360px;
    width: 140%;
  }

  .lp-foot,
  .lp-legal,
  .lp-facts,
  .lp-finish-labels {
    align-items: flex-start;
    flex-direction: column;
    gap: 28px;
  }

  .lp-foot-cols {
    gap: 32px;
  }
}

@media (max-width: 720px) {
  .lp-nav {
    display: flex;
    gap: 10px;
    grid-template-areas: none;
    grid-template-columns: none;
    height: 56px;
    min-height: 56px;
    padding: 0 18px;
  }

  .lp-nav-mid {
    display: none;
  }

  .lp-wordmark,
  .lp-nav-end {
    grid-area: auto;
    justify-self: auto;
    width: auto;
  }

  .lp-wordmark {
    gap: 6px;
  }

  .lp-wordmark-name {
    font-size: 14px;
    letter-spacing: 0.12em;
  }

  .lp-nav-end {
    gap: 10px;
    margin-left: auto;
  }

  .lp-langs {
    gap: 0;
  }

  .lp-lang.is-on,
  .lp-lang-rule {
    display: none;
  }

  .lp-lang {
    font-size: 13px;
    padding: 8px 2px;
  }

  .lp-pill {
    font-size: 11px;
    letter-spacing: 0.08em;
    min-height: 36px;
    padding: 8px 14px;
  }

  .lp-hero {
    height: auto;
    min-height: 0;
  }

  .lp-hero-inner {
    min-height: 0;
    padding: 28px 20px 0;
  }

  .lp-hero-bg {
    background-position: 70% 46%;
  }

  .lp-hero-scrim {
    background-image: linear-gradient(
      180deg,
      rgb(8 8 8 / 62%) 0%,
      rgb(8 8 8 / 18%) 36%,
      rgb(8 8 8 / 88%) 100%
    );
  }

  .lp-hero-kicker {
    gap: 8px;
    padding-bottom: 16px;
  }

  .lp-hero-kicker p {
    font-size: 10px;
    letter-spacing: 0.16em;
    line-height: 14px;
  }

  .lp-hero h1 {
    font-size: 34px;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .lp-hero-lede {
    font-size: 16px;
    line-height: 24px;
    max-width: 20em;
  }

  .lp-hero-lock {
    gap: 28px;
    justify-content: flex-end;
    padding-bottom: 24px;
  }

  .lp-hero-cta {
    align-items: flex-start;
  }

  .lp-pill-hero,
  .lp-pill-lime {
    font-size: 15px;
    justify-content: center;
    min-height: 48px;
    padding: 14px 22px;
    width: auto;
  }

  .lp-hero-floor {
    display: grid;
    gap: 12px 14px;
    grid-template-columns: 1fr 1fr;
    padding: 16px 0 20px;
  }

  .lp-hero-floor span {
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 16px;
  }

  .lp-gallery {
    gap: 24px;
    padding: 56px 20px 40px;
  }

  .lp-gallery-copy {
    gap: 14px;
  }

  .lp-gallery-aside {
    gap: 0;
    padding-bottom: 0;
    width: 100%;
  }

  .lp-gallery-aside p {
    font-size: 16px;
    line-height: 24px;
  }

  .lp-gallery-aside span {
    display: none;
  }

  .lp-gallery-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: visible;
    scroll-snap-type: none;
  }

  .lp-shot {
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    flex: none;
    height: auto;
    width: 100%;
  }

  .lp-shot-sensor {
    min-height: 220px;
    padding: 20px;
  }

  .lp-display-title,
  .lp-comp-head h2,
  .lp-signals-head h2,
  .lp-next-head h2,
  .lp-app-copy h2,
  .lp-radar-copy h2,
  .lp-close h2 {
    font-size: 26px;
    letter-spacing: -0.03em;
    line-height: 1.18;
  }

  .lp-hl-title {
    font-size: 32px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    padding-top: 6px;
  }

  .lp-hl {
    padding: 48px 0 32px;
  }

  .lp-hl-head {
    padding-bottom: 28px;
  }

  .lp-hl-head,
  .lp-hl-grid,
  .lp-app-copy,
  .lp-science,
  .lp-stress,
  .lp-close,
  .lp-foot,
  .lp-legal,
  .lp-signals,
  .lp-next-head {
    padding-left: 20px;
    padding-right: 20px;
  }

  .lp-hl-grid {
    gap: 14px;
  }

  .lp-hl-card {
    border-radius: 22px;
    height: auto;
    width: 100%;
  }

  .lp-hl-media,
  .lp-scan,
  .lp-mini-coach,
  .lp-lock,
  .lp-triad,
  .lp-ai-display {
    height: 280px;
  }

  .lp-ai-inner {
    gap: 8px;
    width: calc(100% - 28px);
  }

  .lp-ai-q span {
    font-size: 12px;
    line-height: 16px;
    padding: 7px 12px;
  }

  .lp-ai-card {
    gap: 10px;
    padding: 12px 14px;
  }

  .lp-ai-grid {
    gap: 8px;
  }

  .lp-ai-row i {
    height: 12px;
    width: 12px;
  }

  .lp-ai-sum strong {
    font-size: 28px;
    line-height: 28px;
  }

  .lp-ai-bar {
    gap: 8px;
    height: 40px;
    margin-top: 0;
  }

  .lp-ai-round {
    height: 40px;
    width: 40px;
  }

  .lp-ai-round svg {
    height: 18px;
    width: 18px;
  }

  .lp-ai-listen {
    height: 40px;
  }

  .lp-ai-listen svg {
    height: 22px;
    width: 68px;
  }

  .lp-triad-row strong {
    font-size: 40px;
    line-height: 40px;
  }

  .lp-hl-copy {
    height: auto;
    padding: 18px 20px 22px;
  }

  .lp-hl-copy p {
    font-size: 18px;
    line-height: 24px;
  }

  .lp-app-copy {
    gap: 14px;
    padding-bottom: 8px;
    padding-top: 56px;
  }

  .lp-app-copy p {
    font-size: 16px;
    line-height: 24px;
    max-width: 22em;
  }

  .lp-phones {
    display: flex;
    gap: 14px;
    height: auto;
    overflow-x: auto;
    padding: 8px 20px 56px;
    scroll-padding-inline: 20px;
    scroll-snap-type: x mandatory;
  }

  .lp-phone,
  .lp-phone-sleep,
  .lp-phone-heart,
  .lp-phone-vitals,
  .lp-phone-battery,
  .lp-phone-l,
  .lp-phone-s,
  .lp-phone-m {
    border-radius: 42px;
    flex: 0 0 248px;
    height: 514px;
    left: auto;
    position: relative;
    top: auto;
    transform: none;
    width: 248px;
  }

  .lp-phone-s .lp-phone-screen,
  .lp-phone-m .lp-phone-screen,
  .lp-phone-l .lp-phone-screen {
    border-radius: 34px;
  }

  .lp-radar {
    gap: 20px;
    padding: 40px 20px;
  }

  .lp-radar img {
    border-radius: 18px;
    height: 220px;
  }

  .lp-comp {
    padding-top: 56px;
  }

  .lp-comp-head {
    gap: 12px;
    padding-bottom: 20px;
    width: calc(100% - 40px);
  }

  .lp-comp-head b,
  .lp-next-head b,
  .lp-signals-head b {
    font-size: 13px;
  }

  .lp-comp-head p,
  .lp-next-head p,
  .lp-signals-head p {
    font-size: 16px;
    line-height: 24px;
  }

  .lp-comp-hero {
    min-height: 0;
    padding: 0 0 4px;
  }

  .lp-comp-phone {
    margin: 8px auto 0;
    -webkit-mask-image: linear-gradient(180deg, #000 86%, transparent);
    mask-image: linear-gradient(180deg, #000 86%, transparent);
    max-height: 640px;
    overflow: hidden;
    width: min(378px, calc(100% - 12px));
  }

  .lp-comp-hero-nums strong {
    font-size: 36px;
    line-height: 40px;
  }

  .lp-stress {
    gap: 24px;
    padding: 48px 20px;
  }

  .lp-stress-live {
    flex-direction: column;
    gap: 18px;
    padding: 20px;
  }

  .lp-stress-head h2 {
    font-size: 24px;
    line-height: 30px;
  }

  .lp-faces {
    margin: 0 -20px;
  }

  .lp-faces-rail {
    gap: 12px;
    padding: 6px 20px 16px;
    scroll-padding-inline: 20px;
  }

  .lp-face {
    flex: 0 0 214px;
  }

  .lp-scan-bg {
    height: 100%;
    left: -24px;
    top: 0;
    width: 130%;
  }

  .lp-scan-plate {
    height: auto;
    left: 14px;
    padding: 14px 8px;
    top: 50%;
    transform: translateY(-50%);
    width: calc(100% - 28px);
  }

  .lp-scan-col strong {
    font-size: 28px;
    line-height: 30px;
  }

  .lp-scan-col em {
    font-size: 14px;
  }

  .lp-mini-coach {
    padding: 0 16px;
  }

  .lp-mini-q span,
  .lp-mini-a p {
    font-size: 15px;
    line-height: 21px;
  }

  .lp-island,
  .lp-today {
    width: calc(100% - 28px);
  }

  .lp-today-col {
    width: auto;
  }

  .lp-today-col strong {
    font-size: 24px;
    line-height: 28px;
  }

  .lp-coach-well {
    border-radius: 16px;
    margin: 0;
  }

  .lp-coach-thread,
  .lp-plan {
    border-radius: 16px;
    padding: 20px 16px;
    width: 100%;
  }

  .lp-q-bubble {
    font-size: 16px;
    line-height: 22px;
    padding: 12px 14px;
  }

  .lp-a {
    gap: 16px;
    padding: 18px 14px;
  }

  .lp-a-head {
    flex-wrap: wrap;
    gap: 8px;
  }

  .lp-a h3,
  .lp-plan h3 {
    font-size: 22px;
    line-height: 28px;
  }

  .lp-a p {
    font-size: 15px;
    line-height: 22px;
  }

  .lp-a-acts a,
  .lp-a-acts span {
    font-size: 13px;
    padding: 10px 14px;
  }

  .lp-plan-foot {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .lp-plan-foot p {
    max-width: none;
  }

  .lp-caps {
    gap: 12px;
  }

  .lp-cap {
    padding: 20px 16px;
    width: 100%;
  }

  .lp-science {
    gap: 24px;
  }

  .lp-science-lede,
  .lp-science-legal {
    font-size: 15px;
    line-height: 22px;
    max-width: none;
  }

  .lp-science-ticker {
    font-size: 11px;
    letter-spacing: 0.12em;
    overflow-wrap: anywhere;
  }

  .lp-stress-num {
    width: 100%;
  }

  .lp-stress-num strong {
    font-size: 32px;
  }

  .lp-stress-move p {
    font-size: 18px;
    line-height: 24px;
  }

  .lp-stress-out article {
    padding: 20px 16px;
  }

  .lp-stress-out h3 {
    font-size: 36px;
    line-height: 40px;
  }

  .lp-signals-head h2 {
    font-size: 32px;
    line-height: 36px;
  }

  .lp-close-orbit {
    height: 240px;
    top: 12px;
    width: 180%;
  }

  .lp-finish-labels {
    gap: 16px;
  }

  .lp-finish-labels div {
    width: auto;
  }

  .lp-next-head {
    padding-bottom: 28px;
    padding-top: 56px;
  }

  .lp-finishes {
    padding: 56px 0 36px;
  }

  .lp-finishes-head {
    padding-bottom: 24px;
    width: calc(100% - 40px);
  }

  .lp-finishes-head strong {
    font-size: 48px;
    line-height: 1;
  }

  .lp-facts {
    display: grid;
    gap: 18px 16px;
    grid-template-columns: 1fr 1fr;
    padding-bottom: 28px;
    width: calc(100% - 40px);
  }

  .lp-facts div {
    width: auto;
  }

  .lp-finish-labels {
    width: calc(100% - 40px);
  }

  .lp-chase,
  .lp-finishes-photo {
    height: 280px;
  }

  .lp-chase-words {
    bottom: 16px;
    font-size: 11px;
    left: 20px;
    letter-spacing: 0.1em;
    right: 20px;
  }

  .lp-signals {
    gap: 28px;
    padding: 56px 20px;
  }

  .lp-sig-icon {
    height: 64px;
    width: 64px;
  }

  .lp-close {
    padding: 72px 20px 64px;
  }

  .lp-close b {
    margin-bottom: 16px;
  }

  .lp-close p {
    margin-bottom: 24px;
  }

  .lp-foot {
    gap: 28px;
    padding: 36px 20px;
  }

  .lp-legal {
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 20px;
  }
}
