.site-main.is-landing {
  background: #000;
  padding: 0;
}

.lp {
  --lp-ink: #070709;
  --lp-lime: #eff65a;
  --lp-paper: #ffffff;
  --lp-mute: rgb(255 255 255 / 60%);
  --lp-dim: rgb(255 255 255 / 42%);
  --lp-hair: #ffffff14;
  --lp-display: 'Inter Tight', 'Noto Sans SC', system-ui, sans-serif;
  --lp-body: 'Jost', 'Noto Sans SC', system-ui, sans-serif;
  --lp-doto: 'Doto', 'Noto Sans SC', ui-monospace, monospace;
  --lp-inter: 'Inter', 'Noto Sans SC', system-ui, sans-serif;
  --lp-serif: 'Noto Serif SC', 'Noto Sans SC', Georgia, serif;
  --lp-neue: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  --lp-max: none;
  background: #000;
  color: #fff;
  font-family: var(--lp-body);
  overflow-x: clip;
  width: 100%;
}

.lp * {
  box-sizing: border-box;
}

.lp a {
  color: inherit;
  text-decoration: none;
}

.lp a.lp-pill,
.lp a.lp-pill-lime,
.lp a.lp-app-cta {
  color: var(--lp-ink);
}

.lp img {
  display: block;
  max-width: 100%;
}

.lp-shell {
  background: #000;
  margin: 0;
  max-width: none;
  width: 100%;
}

.lp-nav {
  align-items: center;
  background: #000;
  border-bottom: 1px solid var(--lp-hair);
  display: flex;
  height: 72px;
  justify-content: space-between;
  padding: 0 48px;
  position: sticky;
  top: 0;
  z-index: 30;
}

.lp-wordmark {
  align-items: center;
  display: flex;
  gap: 8px;
}

.lp-wordmark-name {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.16em;
  line-height: 22px;
}

.lp-pip {
  background: var(--lp-lime);
  border-radius: 1px;
  flex-shrink: 0;
  height: 7px;
  width: 7px;
}

.lp-nav-mid {
  display: flex;
  gap: 32px;
  left: 50%;
  position: absolute;
  transform: translateX(-50%);
}

.lp-nav-link {
  color: rgb(255 255 255 / 60%);
  font-family: var(--lp-body);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: 16px;
}

.lp[data-locale='zh'] .lp-nav-link {
  font-size: 13px;
  letter-spacing: 0.05em;
}

.lp-nav-end {
  align-items: center;
  display: flex;
  gap: 24px;
}

.lp-langs {
  align-items: center;
  display: flex;
  gap: 8px;
}

.lp-lang {
  color: #ffffff8c;
  font-family: var(--lp-body);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
}

.lp-lang.is-on {
  color: #fff;
}

.lp[data-locale='zh'] .lp-lang.is-on {
  font-family: 'Noto Sans SC', sans-serif;
  font-size: 13px;
  letter-spacing: 0.05em;
}

.lp-lang-rule {
  background: #ffffff38;
  flex-shrink: 0;
  height: 10px;
  width: 1px;
}

.lp-sign {
  color: rgb(255 255 255 / 60%);
  font-family: var(--lp-body);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
}

.lp-pill {
  align-items: center;
  background: #fff;
  border: 0;
  border-radius: 999px;
  color: var(--lp-ink);
  display: inline-flex;
  font-family: var(--lp-display);
  font-size: 12px;
  font-weight: 600;
  gap: 12px;
  letter-spacing: 0.12em;
  line-height: 16px;
  padding: 10px 20px;
}

.lp-pill-hero {
  font-family: var(--lp-doto);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 20px;
  padding: 20px 42px;
}

.lp-pill-lime {
  background: var(--lp-lime);
  color: var(--lp-ink);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 20px 42px;
}

.lp-hero {
  background: #000;
  height: 820px;
  overflow: clip;
  position: relative;
}

.lp-hero-bg {
  background-image: url('{{ 'hero.png' | asset_url }}');
  background-position: 62% 58%;
  background-size: cover;
  inset: 0;
  position: absolute;
}

.lp-hero-scrim {
  background-image:
    linear-gradient(90deg, rgb(8 8 8 / 78%) 0%, rgb(8 8 8 / 52%) 26%, rgb(8 8 8 / 0%) 52%),
    linear-gradient(180deg, rgb(8 8 8 / 40%) 0%, rgb(8 8 8 / 0%) 30%, rgb(8 8 8 / 0%) 72%, rgb(8 8 8 / 55%) 100%);
  inset: 0;
  position: absolute;
}

.lp-hero-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: space-between;
  padding: 72px 56px 0;
  position: relative;
}

.lp-hero-lock {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 40px;
}

.lp-hero-kicker {
  align-items: center;
  display: flex;
  gap: 14px;
  padding-bottom: 24px;
}

.lp-hero-kicker p {
  color: var(--lp-lime);
  font-family: var(--lp-doto);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.4em;
  line-height: 16px;
}

.lp-hero h1 {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 76px;
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 76px;
  text-shadow: #00000066 0 4px 40px;
  text-transform: uppercase;
  white-space: pre;
}

.lp-hero-bottom {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.lp-hero-lede {
  color: #ffffffd9;
  font-family: var(--lp-body);
  font-size: 17px;
  line-height: 26px;
  max-width: 320px;
}

.lp-hero-cta {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.lp-hero-nosub {
  align-items: center;
  display: flex;
  gap: 10px;
}

.lp-hero-nosub i {
  background: var(--lp-lime);
  border-radius: 999px;
  height: 6px;
  width: 6px;
}

.lp-hero-nosub span {
  color: #ffffffcc;
  font-family: var(--lp-body);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.14em;
  line-height: 16px;
  text-transform: uppercase;
}

.lp-hero-floor {
  align-items: center;
  border-top: 1px solid #ffffff24;
  display: flex;
  justify-content: space-between;
  padding: 22px 0 26px;
}

.lp-hero-floor span {
  color: #ffffffd1;
  font-family: var(--lp-doto);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.34em;
  line-height: 16px;
}

.lp-gallery {
  background: #070709;
  border-bottom: 1px solid var(--lp-hair);
  display: flex;
  flex-direction: column;
  gap: 48px;
  padding: 112px 48px 96px;
}

.lp-gallery-head {
  align-items: end;
  display: flex;
  justify-content: space-between;
}

.lp-kicker-lime {
  color: var(--lp-lime);
  font-family: var(--lp-doto);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.34em;
  line-height: 16px;
}

.lp-display-title {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 56px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 92%;
  text-transform: uppercase;
  white-space: pre-wrap;
}

.lp[data-locale='zh'] .lp-gallery .lp-display-title {
  line-height: 112%;
}

.lp-gallery-copy {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.lp-gallery-aside {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  gap: 12px;
  padding-bottom: 6px;
  width: 360px;
}

.lp-gallery-aside p {
  color: #ffffff99;
  font-size: 16px;
  line-height: 160%;
}

.lp-gallery-aside span {
  color: #ffffff4d;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  line-height: 14px;
  text-transform: uppercase;
}

.lp-gallery-row {
  display: flex;
  gap: 12px;
}

.lp-shot {
  background-position: 50%;
  background-size: cover;
  border-radius: 8px;
  flex: 1;
  height: 550px;
  min-width: 0;
  overflow: clip;
}

.lp-shot-sensor {
  border: 1px dashed #ffffff29;
  display: flex;
  justify-content: space-between;
  padding: 24px;
}

.lp-shot-sensor b {
  color: var(--lp-lime);
  font-family: var(--lp-doto);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.3em;
}

.lp-shot-sensor span {
  color: #ffffff4d;
  font-family: var(--lp-doto);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.3em;
}

.lp-hl {
  background: #f5f5f7;
  padding: 120px 0 80px;
}

.lp-hl-head {
  display: flex;
  padding: 0 80px 56px;
}

.lp-hl-kicker {
  color: #6e6e73;
  font-family: var(--lp-inter);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  line-height: 16px;
}

.lp-hl-title {
  color: #1d1d1f;
  font-family: var(--lp-inter);
  font-size: 56px;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 60px;
  padding-top: 14px;
}

.lp-hl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  padding: 0 80px;
}

.lp-hl-card {
  background: #000;
  border-radius: 28px;
  display: flex;
  flex-direction: column;
  height: 465px;
  overflow: clip;
  width: calc((100% - 48px) / 3);
}

.lp-hl-media {
  background-position: 50%;
  background-size: cover;
  flex-shrink: 0;
  height: 340px;
}

.lp-hl-copy {
  display: flex;
  flex-direction: column;
  gap: 8px;
  height: 125px;
  padding: 28px 28px 32px;
}

.lp-hl-copy b {
  color: var(--lp-lime);
  font-family: var(--lp-inter);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  line-height: 16px;
}

.lp-hl-copy p {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 26px;
}

.lp-triad {
  display: flex;
  flex-direction: column;
  gap: 22px;
  height: 340px;
  justify-content: center;
  padding: 0 32px;
}

.lp-triad-row {
  align-items: end;
  display: flex;
  justify-content: space-between;
}

.lp-triad-row strong {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 60px;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 60px;
}

.lp-triad-row span {
  color: #a1a1a6;
  font-family: var(--lp-inter);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.06em;
  line-height: 16px;
  padding-bottom: 10px;
}

.lp-triad hr {
  background: #ffffff1f;
  border: 0;
  height: 1px;
  margin: 0;
}

.lp-scan {
  height: 340px;
  overflow: clip;
  position: relative;
}

.lp-scan-bg {
  background-image: url('{{ 'scan.png' | asset_url }}');
  background-position: 50%;
  background-size: cover;
  height: 400px;
  left: -120px;
  position: absolute;
  top: -40px;
  width: 640px;
}

.lp-scan-plate {
  align-items: center;
  background: #1a1a1a;
  border: 1px solid #ffffff1f;
  border-radius: 18px;
  display: flex;
  height: 116px;
  left: 32px;
  position: absolute;
  top: 112px;
  width: calc(100% - 64px);
}

.lp-scan-col {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8px;
}

.lp-scan-col strong {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 46px;
  font-weight: 700;
  letter-spacing: -0.045em;
  line-height: 50px;
}

.lp-scan-col em {
  color: #8a8a8a;
  font-family: var(--lp-display);
  font-size: 18px;
  font-style: normal;
  letter-spacing: -0.01em;
}

.lp-scan-col span {
  color: #a1a1a6;
  font-family: var(--lp-inter);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.lp-scan-rule {
  background: #ffffff1f;
  height: 72px;
  width: 1px;
}

.lp-mini-coach {
  display: flex;
  flex-direction: column;
  gap: 14px;
  height: 340px;
  justify-content: center;
  padding: 0 24px;
}

.lp-mini-q {
  display: flex;
  justify-content: flex-end;
}

.lp-mini-q span {
  background: #2c2c2e;
  border-radius: 20px;
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 16px;
  line-height: 22px;
  padding: 12px 18px;
}

.lp-mini-a {
  background: #141414;
  border: 1px solid #ffffff1f;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px 20px 20px;
}

.lp-mini-a-k {
  align-items: center;
  display: flex;
  gap: 8px;
}

.lp-mini-a-k i {
  background: var(--lp-lime);
  border-radius: 999px;
  height: 6px;
  width: 6px;
}

.lp-mini-a-k span {
  color: var(--lp-lime);
  font-family: var(--lp-inter);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.lp-mini-a p {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 26px;
}

.lp-mini-a button,
.lp-mini-a .lp-mini-act {
  background: var(--lp-lime);
  border: 0;
  border-radius: 999px;
  color: #141414;
  display: inline-block;
  font-family: var(--lp-inter);
  font-size: 13px;
  font-weight: 500;
  line-height: 16px;
  padding: 8px 14px;
  width: fit-content;
}

.lp-lock {
  align-items: center;
  background: #111114;
  display: flex;
  flex-direction: column;
  gap: 18px;
  height: 340px;
  justify-content: center;
}

.lp-island {
  align-items: center;
  background: #000;
  border-radius: 999px;
  display: flex;
  height: 52px;
  justify-content: space-between;
  padding: 0 20px 0 22px;
  width: 300px;
}

.lp-island-l {
  align-items: center;
  display: flex;
  gap: 10px;
}

.lp-island-l i {
  background: #ff453a;
  border-radius: 999px;
  height: 8px;
  width: 8px;
}

.lp-island-l span {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.lp-island-r {
  align-items: baseline;
  display: flex;
  gap: 6px;
}

.lp-island-r strong {
  color: var(--lp-lime);
  font-family: var(--lp-display);
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.lp-island-r span {
  color: #a1a1a6;
  font-family: var(--lp-inter);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.lp-today {
  background: #1c1c1e;
  border-radius: 22px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 18px 20px;
  width: 300px;
}

.lp-today-k {
  color: var(--lp-lime);
  font-family: var(--lp-inter);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.lp-today-row {
  display: flex;
  justify-content: space-between;
}

.lp-today-col {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 84px;
}

.lp-today-col strong {
  color: #fff;
  font-family: var(--lp-display);
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 34px;
}

.lp-today-col span {
  color: #a1a1a6;
  font-family: var(--lp-inter);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.lp-ai-display {
  align-items: center;
  background: #111114;
  display: flex;
  flex-direction: column;
  height: 340px;
  justify-content: center;
}

.lp-ai-inner {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: calc(100% - 42px);
}

.lp-ai-q {
  display: flex;
  justify-content: flex-end;
}

.lp-ai-q span {
  background: #1c1c1e;
  border-radius: 999px;
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 17px;
  padding: 8px 16px;
}

.lp-ai-card {
  background: #101014;
  border: 1px solid #ffffff14;
  border-radius: 22px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 20px;
}

.lp-ai-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.lp-ai-row {
  display: flex;
  justify-content: space-between;
}

.lp-ai-row i {
  background: #ffffff21;
  border-radius: 999px;
  flex-shrink: 0;
  height: 16px;
  width: 16px;
}

.lp-ai-row i.is-on {
  background: var(--lp-lime);
}

.lp-ai-sum {
  align-items: baseline;
  display: flex;
  gap: 10px;
}

.lp-ai-sum strong {
  color: var(--lp-lime);
  font-family: var(--lp-display);
  font-size: 36px;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 36px;
}

.lp-ai-sum span {
  color: #ffffff8c;
  font-family: var(--lp-inter);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  line-height: 14px;
}

.lp-ai-bar {
  align-items: center;
  display: flex;
  gap: 14px;
  height: 56px;
  margin-top: 8px;
}

.lp-ai-round {
  align-items: center;
  background: #101014;
  border: 1px solid #ffffff14;
  border-radius: 999px;
  display: flex;
  flex-shrink: 0;
  height: 54px;
  justify-content: center;
  width: 54px;
}

.lp-ai-listen {
  align-items: center;
  background: var(--lp-lime);
  border-radius: 28px;
  display: flex;
  flex: 1;
  height: 56px;
  justify-content: center;
  min-width: 0;
}

.lp-ai-listen svg {
  display: block;
  height: 32px;
  width: min(96px, 100%);
}

.lp-app {
  background: #000;
  position: relative;
}

.lp-app-copy {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 80px 80px 24px;
  text-align: center;
}

.lp-app-copy h2 {
  color: #fff;
  font-family: var(--lp-serif);
  font-size: 48px;
  letter-spacing: -0.03em;
  line-height: 56px;
}

.lp-app-copy p {
  color: #fff;
  font-family: var(--lp-inter);
  font-size: 20px;
  line-height: 28px;
}

.lp-app-copy span {
  color: #a8a5a0;
  font-size: 14px;
  line-height: 18px;
}

.lp-app-cta {
  background: #fff;
  border-radius: 999px;
  color: #000;
  font-family: var(--lp-inter);
  font-size: 16px;
  line-height: 20px;
  padding: 14px 24px;
}

.lp-phones {
  height: 620px;
  overflow: clip;
  position: relative;
}

.lp-phone {
  background: #1b1b1f;
  border: 1px solid #44444c;
  box-shadow: #0000009e 0 28px 60px;
  overflow: hidden;
  padding: 7px;
  position: absolute;
}

.lp-phone-screen {
  background: #000;
  height: 100%;
  overflow: clip;
  width: 100%;
}

.lp-phone-screen img {
  height: 100%;
  object-fit: cover;
  object-position: 50% 0;
  width: 100%;
}

.lp-phone-notch {
  background: #000;
  border-radius: 9px;
  height: 16px;
  left: 50%;
  position: absolute;
  top: 16px;
  transform: translateX(-50%);
  width: 54px;
}

.lp-phone-s {
  border-radius: 37px;
  height: 410px;
  width: 198px;
}

.lp-phone-s .lp-phone-screen {
  border-radius: 30px;
}

.lp-phone-m {
  border-radius: 43px;
  height: 473px;
  padding: 8px;
  width: 228px;
}

.lp-phone-m .lp-phone-screen {
  border-radius: 35px;
}

.lp-phone-m .lp-phone-notch {
  border-radius: 10px;
