{% assign shop_locale = 'en' %}
{% if request.path contains '/pages/zh' or request.query_parameters.lang == 'zh' %}
  {% assign shop_locale = 'zh' %}
{% endif %}

<div class="shop-app" id="nb-shop" data-locale="{{ shop_locale }}"></div>

