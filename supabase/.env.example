# Edge Function secrets — set with: supabase secrets set --env-file supabase/.env
AI_GATEWAY_API_KEY=
DASHSCOPE_API_KEY=
SETTLE_SECRET=

# Auth SMTP (Resend API key). Read by config.toml as env(SUPABASE_AUTH_SMTP_PASS) for local
# runs, and by scripts/auth-config.sh to set the hosted project.
SUPABASE_AUTH_SMTP_PASS=
# Personal access token from https://supabase.com/dashboard/account/tokens — scripts/auth-config.sh only.
SUPABASE_ACCESS_TOKEN=
