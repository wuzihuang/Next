# Edge Function secrets — set with: supabase secrets set --env-file supabase/.env
GROK_BASE_URL=https://216.36.87.44:8445/v1
GROK_API_KEY=
GROK_MODEL=grok-4.6
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-flash
SETTLE_SECRET=

# Auth SMTP (Resend API key). Read by config.toml as env(SUPABASE_AUTH_SMTP_PASS) for local
# runs, and by scripts/auth-config.sh to set the hosted project.
SUPABASE_AUTH_SMTP_PASS=
# Personal access token from https://supabase.com/dashboard/account/tokens — scripts/auth-config.sh only.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------- Jev (typesafe.ai)
# ADR 0031 · limited read-only routing inside /turn. Production default is off, and a
# missing key forces off whatever JEV_MODE says.
TYPESAFE_API_KEY=
# Pinned on purpose: thresholds are tuned against one version, and jev-latest moves.
TYPESAFE_MODEL=jev-1.13.0
# off | shadow | on. `shadow` makes no online call in this version (see typesafe.ts).
JEV_MODE=off
JEV_TIMEOUT_MS=1500
JEV_TOTAL_WAIT_MS=2500
JEV_MAX_CALLS_PER_TURN=2
JEV_SHADOW_SAMPLE_RATE=0
JEV_ASSISTED_ENABLED=false
# Comma-separated task ids. `on` opens only tasks that are BOTH listed here and marked
# evaluated in _shared/jev-policy.ts: fast.single_read, assisted.read_with_explanation
JEV_TASK_ALLOWLIST=
# Development only: lets an unevaluated task run on a developer's machine.
JEV_ALLOW_UNEVALUATED=false
